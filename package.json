{
  "name": "anbaric-root",
  "private": true,
  "workspaces": [
    "tsapi",
    "anbaric-web",
    "anbaric-state-machine",
    "anbaric-data-store",
    "anbaric-impl-cloud",
    "anbaric",
    "anbaric-cloud-hosting",
    "anbaric-hosting",
    "anbaric-plugins",
    "anbaric-services-client",
    "anbaric-cli"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc -b anbaric/tsconfig.build.json",
    "clean": "tsc -b anbaric/tsconfig.build.json --clean",
    "versions": "tsx scripts/set-versions.ts",
    "release": "npm run versions && npm run build && npx vitest run && npm publish --workspaces --access public --tag latest"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^4.1.10"
  },
  "version": "1.56.1"
}
