{
  "name": "anbaric-data-store",
  "version": "1.53.0",
  "description": "Data stores for Anbaric apps: schema-validated JSON documents, encrypted secrets, and a relational (SQL) store, backed in memory / SQLite locally or by the Anbaric Cloud",
  "license": "MIT",
  "author": "chris@anbaric.ai",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "anbaric-impl-cloud": "^1.53.0",
    "anbaric-tsapi": "^1.53.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
