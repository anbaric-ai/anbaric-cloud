{
  "name": "anbaric-mcp",
  "version": "1.21.5",
  "description": "MCP server exposing the Anbaric platform API as JSON tools for agents",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js \"--banner:js=#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run bundle"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
